    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f7;
    on-surface: #1e1b1a;
    on-surface-variant: #4a4645;
    outline: #7c7675;
    outline-variant: #ccc5c4;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #332f2f;
    inverse-on-surface: #f7efed;
    inverse-primary: #dfbfba;
    surface-dim: #e0d8d7;
    surface-bright: #fff8f7;
    surface-container-lowest: #ffffff;
